# Supabase. The project address and publishable key are in src/lib/supabase-public.ts (they are public).
# Only the secret key goes here.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Who can open /admin (comma separated)
ADMIN_EMAILS=

# Push notifications: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aayamik.com

# Any long random string; Vercel cron sends it automatically
CRON_SECRET=

# Payments stay off until GST is settled
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
NEXT_PUBLIC_PRICE_MONTHLY=
NEXT_PUBLIC_PRICE_YEARLY=

# For the cost estimate in Admin → Usage
USD_INR=95

# Cloudflare R2: where original book files (and later the lesson audio) are kept.
# Without these, files are kept in Supabase storage instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shravan-files

# Let learners download their own uploads and public-domain library books (admin can always download)
LEARNER_DOWNLOADS=false

# Narrator voice (Sarvam Bulbul). Without it, lessons use the phone's own voice.
SARVAM_API_KEY=
# Cost estimate used for the monthly voice budget (₹ per 10,000 characters)
VOICE_INR_PER_10K=10
