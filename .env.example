# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Who can open /admin (comma separated)
ADMIN_EMAILS=

# Push notifications: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aayamik.com

# Any long random string; Vercel cron sends it automatically
CRON_SECRET=

# Payments stay off until GST is settled
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
NEXT_PUBLIC_PRICE_MONTHLY=
NEXT_PUBLIC_PRICE_YEARLY=

# For the cost estimate in Admin → Usage
USD_INR=95
